# Codespaces Environment Configuration
# This file is automatically used when running in GitHub Codespaces

# API Configuration - Uses Codespaces port forwarding
API_BASE_URL=https://${CODESPACE_NAME}-5000.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}/api
API_TIMEOUT=15000

# App Configuration
APP_NAME=EarnQuest
APP_VERSION=1.0.0

# Development Settings
DEBUG_MODE=true
